UpBodyText":"See how easy it is to manage\u003cbr\u003eyour work on monday.com","liveBoard.openPopUpButtonText":"Let's go","button.subscribe":"Subscribe","button.thankYou":"Thank you for subscribing!","exitPopup.title":"I want to hug the people that created this.","exitPopup.subtitle":"- Emma J Coulson, with monday.com since 2014","exitPopup.signupTitle":"Join %param1%+ teams who are passionate about monday.com","exitPopup.signupInputPlaceholder":"Enter your work email","exitPopup.signupButtonText":"Start free trial","exitPopup.footerText":"No thanks","pricingPage.purchaseNow":"purchase now","pricingPage.purchaseNow.modal.title":"Try before you buy!","pricingPage.purchaseNow.modal.subtitle":"Get started with a free \u003cb\u003e14-day Pro trial\u003c/b\u003e.\u003cbr\u003eYou can complete your purchase anytime during your trial.","pricingPage.included":"Included","pricingPage.notIncluded":"Not included","pricingPage.pricingData.pageHeaderTitle":"Start your \u003cbrand-indigo\u003efree\u003c/end\u003e trial","pricingPage.pricingData.pageHeaderTitleVariantA":"Take your efficiency to the next level.","pricingPage.pricingData.pageHeaderTitleVariantB":"Supercharge your teamwork. Start \u003cbrand-indigo\u003efree\u003c/end\u003e.","pricingPage.pricingData.pageAdditionalDescription":"Unlimited boards and workflows. No credit card needed.","pricingPage.pricingData.pageAdditionalDescription.subtitle.v2":"14 days free trial. No credit card required.","pricingPage.pricingData.pageAdditionalDescription.quote.text":"\"We love hearing that our pricing is amazing. It means the cost is \u003cbr\u003e a fraction of the value customers get - and that's our objective!\"","pricingPage.pricingData.pageAdditionalDescription.quote.sayer":"Roy Mann | CEO","pricingPage.pricingData.pageAdditionalDescription.newContent":"Start your free trial. No credit card needed.","pricingPage.pricingData.middlePageTextHtml":"A collaboration app for teams and people like you","pricingPage.pricingData.bottomTitle":"Start using monday.com today","pricingPage.pricingData.bottomDescription":"Try it now for free / No credit card needed","pricingPage.pricingData.productSwitcher.crm.tooltip":"Manage all stages of the customer lifecycle from lead to post-sales","pricingPage.pricingData.productSwitcher.core.tooltip":"Manage any kind of work, from tasks to complex projects, in one place","pricingPage.pricingData.productSwitcher.software.tooltip":"Manage your development flow from ideation to launch","pricingPage.pricingData.productSwitcher.service.tooltip":"Manage and automate your organization's entire service operations in one place","pricingPage.trustSection.title":"Over 180,000 customers worldwide rely on\u003cbr\u003emonday.com","pricingPage.faq":"Frequently Asked Questions","pricingPage.inAddition":"in addition to:","pricingPage.chooseTeamSize":"Choose team size: ","pricingPage.numberOfContacts":"Number of contacts: ","pricingPage.chooseBillingPeriod":"Choose billing period: ","pricingPage.seats":"Seats","pricingPage.contacts":"Contacts","pricingPage.seats.underXFree":"≤%param1% Seats - free!","pricingPage.users":"Users","pricingPage.numberOfUsers":"%param1% users","pricingPage.numberOfSeats":"%param1% seats","pricingPage.percentageOff":"%param1%% off","pricingPage.perSeatPerMonth":"Per seat/month","pricingPage.billedAnnually":"billed annually","pricingPage.billedMonthly":"billed monthly","pricingPage.minimum":"Minimum","pricingPage.signupModalTitle":"Get Started With monday.com","pricingPage.signupModalSecondaryTitle":"Simple, visual collaboration","pricingPage.signupModalStartFreeTrial":"Start your free trial","pricingPage.includes":"includes","pricingPage.allPreviousFeatures":"all %param1% plan features,","pricingPage.periods.title":"Billing period","pricingPage.periods.monthly.billed":"Billed monthly","pricingPage.periods.monthly.displayName":"Monthly","pricingPage.periods.yearly.billed":"Billed annually","pricingPage.periods.yearly.displayName":"Yearly SAVE 18%","pricingPage.periods.yearly.displayNameShort":"Yearly","pricingPage.periods.save":"SAVE 18%","pricingPage.periods.saveCRMNew":"SAVE 33%","pricingPage.freeForever":"Free forever","pricingPage.upToXSeats":"Up to %param1% seats","pricingPage.pickYourPlan":"Pick your plan","pricingPage.completeFeaturesList":"Complete features list","pricingPage.seeCompleteFeaturesList":"See complete features list","pricingPage.hideCompleteFeaturesList":"Hide complete features list","pricingPage.month":"month","pricingPage.year":"year","pricingPage.mostPopular":"Most Popular","pricingPage.comingSoon":"Coming Soon","pricingPage.soon":"Soon","pricingPage.monthAndSeatIndication":"Per seat, per month","pricingPage.seatPeriod":"Per seat / month","pricingPage.perSeat":"Per seat","pricingPage.perMonth":"Per month","pricingPage.perMonthSlash":"/ month","pricingPage.seatOver":"seat /","pricingPage.free":"free","pricingPage.forever":"forever","pricingPage.total":"Total","pricingPage.total.withNumber":"Total %param1% / month","pricingPage.addons.vibe.bannerText":"Vibe apps are offered as an add-on across all monday plans","pricingPage.addons.vibe.options.draftOnly":"Draft apps only","pricingPage.addons.vibe.options.10apps":"10 published apps","pricingPage.addons.vibe.options.25apps":"25 published apps","pricingPage.addons.vibe.featureText":"%param1% published vibe apps","pricingPage.total.withNumber.yearly":"Total %param1% / year","pricingPage.round_note":"The actual price per seat is %param1%, listed price is rounded up to the nearest whole number","pricingPage.faq.questions":"Questions?","pricingPage.faq.new.freeVersion.question":"Is there a free version of monday.com?","pricingPage.faq.new.freeVersion.answer":"If you would like to access monday.com beyond the 14-day trial, you can do so through purchasing a plan. If you are a \u003ca href='https://forms.monday.com/forms/9f862eef0081db8c8b6e1f9f574bdabf' rel='noopener noreferrer' target='_blank'\u003enonprofit\u003c/a\u003e, you may be qualified to access monday.com for free or at a discount by filling out the designated forms.","pricingPage.faq.new.freeVersion.answer.for_free_tier":"Yes! Our Individual Plan is for independent professionals looking to keep track of their tasks and work. If you are interested in using only the most essential features of monday.com, this is the plan for you!","pricingPage.faq.new.cost.question":"How much does monday.com cost?","pricingPage.faq.new.cost.answer":"monday.com starts from $24 per month for 3 users and goes up from there based on your chosen plan and team size. If you are over 40 users, you can \u003ca href='https://monday.com/sales/contact-us?from=pricing\u0026source=Website%20-%20Contact%20Sales' rel='noopener noreferrer' target='_blank'\u003erequest a quote\u003c/a\u003e to get an exact price.","pricingPage.faq.new.monthly.question":"Can you pay for monday.com monthly?","pricingPage.faq.new.monthly.answer":"Yes, you can pay monthly for your account. Choose the monthly option on the pricing page and you will be able to pay on a per month basis. The monthly plan is not discounted so if you are looking to save, we recommend the yearly plan.","pricingPage.faq.new.rightPlanForMe.question":"Which pricing plan is right for me?","pricingPage.faq.new.rightPlanForMe.answer":"We understand that each organization is unique, requiring specific features to support its workflows and projects. Above you can see the features included in the different plans to support your needs. If you need help in choosing the right plan for you, check out \u003ca href='https://monday.com/blog/product/monday-com-pricing-which-plan-is-right-for-you/' rel='noopener noreferrer' target='_blank'\u003ethis article\u003c/a\u003e or reach out to our \u003ca href='https://monday.com/sales/contact-us?from=pricing\u0026source=Website%20-%20Contact%20Sales' rel='noopener noreferrer' target='_blank'\u003esales team\u003c/a\u003e.","pricingPage.faq.new.howDoesOurPricingWork.question":"How does our pricing work?","pricingPage.faq.new.howDoesOurPricingWork.answer":"Our pricing is based on 2 variables: the feature plan you’d like to use, and the number of users on the platform. Once you’ve decided on the feature plan and users, choose your preferred subscription payment: month-to-month or annual. Payment is made in one upfront installment (so if you purchase a plan for one year, you will pay for one year upfront).","pricingPage.faq.new.changedMyMind.question":"What if I change my mind?","pricingPage.faq.new.changedMyMind.answer":"If you've paid for a yearly subscription in the last 30-days, and need to cancel your account, you are entitled to a prorated refund. We will automatically refund you the remaining balance from your original purchase. Simply cancel the account from the Admin section, and your account will be automatically refunded. If you have any questions, you can always reach out to \u003ca href='mailto: support@monday.com' target='_blank'\u003esupport@monday.com\u003c/a\u003e","pricingPage.faq.new.changedMyMind.answer.updated":"If you've paid for a yearly subscription in the last 30-days, and need to cancel your account, you are entitled to a prorated refund. We will automatically refund you the remaining balance from your original purchase. Simply cancel the account from the Admin section, and your account will be automatically refunded. If you have any questions, you can always reach out to our \u003ca href='https://support.monday.com/hc/en-us/p/support-lp' target='_blank'\u003esupport team\u003c/a\u003e","pricingPage.faq.new.discount.question":"Do you offer any discounted plans?","pricingPage.faq.new.discount.answer":"Yes, through choosing a yearly plan, you will receive an 18% discount.","pricingPage.faq.new.students.question":"Does monday.com offer plans for students?","pricingPage.faq.new.students.answer":"Yes, our \u003ca href='https://monday.com/lp/students/' rel='noopener noreferrer' target='_blank'\u003eStudent Program\u003c/a\u003e offers great opportunities and options for students and student organizations who would like to implement monday.com in their classes. University/college students, student organisations, fraternities, and sororities can all join the student programs.","pricingPage.faq.new.nonProfits.question":"Does monday.com offer plans to nonprofits and NGOs?","pricingPage.faq.new.nonProfits.answer":"monday.com is a proud supporter of organizations that do great things around the world. That’s why we offer discounted pricing for qualified nonprofit organisations. \u003ca href=\"https://monday.com/nonprofits\" target=\"_blank\"\u003eClick here\u003c/a\u003e to find out more about our nonprofit plan and pricing.","pricingPage.faq.new.manageBilling.question":"How can I manage my billing?","pricingPage.faq.new.manageBilling.answer":"If you are an admin of your account, you can access your purchase history, invoices, payment details, plan type, and more. Learn how to manage your billing details \u003ca href='https://support.monday.com/hc/en-us/articles/360018098000-How-to-manage-my-billing-' rel='noopener noreferrer' target='_blank'\u003ehere\u003c/a\u003e.","pricingPage.faq.new.changePlan.question":"Can I change my plan?","pricingPage.faq.new.changePlan.answer":"You can make changes to your plan at any time by changing your plan type and adding and removing users (Note that post the refund period, we offer no refunds for downgrades). To change your plan, simply go into the Admin section and click on the Billing option. From there, click on 'change plan', pick the desired plan, and enjoy!","pricingPage.faq.new.security.question":"How secure is monday.com?","pricingPage.faq.new.security.answer":"The security of our customer’s data is our top priority. monday.com is built with strict security requirements and protocols to secure your data, such as ISO/IEC 27001 and ISO/IEC 27018, and is undergoing annual security audits and assessments. We use high physical, procedural, and technical security measures to preserve the integrity and security of your data, as well as adhering to the strictest data protection laws.","pricingPage.faq.new.paymentMethods.question":"What payment methods do you accept?","pricingPage.faq.new.paymentMethods.answer":"We accept the following payment methods: All the major credit cards (excluding debit cards) - Visa, Master Card, American Express, Discover, Diners Club, JCB, Carte Bleue, Union Pay. You can also purchase your monday.com subscription with PayPal. (Note this may be subject to change depending on your location.)\u003cbr\u003e We accept invoices for Enterprise orders that meet a minimum fee - Feel free to reach out to \u003ca href='mailto:support@monday.com' target='_blank'\u003esupport@monday.com\u003c/a\u003e for more information.","pricingPage.faq.new.paymentMethods.answer.updated":"We accept the following payment methods: All the major credit cards (excluding debit cards) - Visa, Master Card, American Express, Discover, Diners Club, JCB, Carte Bleue, Union Pay. You can also purchase your monday.com subscription with PayPal. (Note this may be subject to change depending on your location.)\u003cbr\u003e We accept invoices for Enterprise orders that meet a minimum fee - Feel free to reach out to our \u003ca href='https://support.monday.com/hc/en-us/p/support-lp' target='_blank'\u003esupport team\u003c/a\u003e for more information.","pricingPage.faq.new.mobile.question":"Do you have mobile apps?","pricingPage.faq.new.mobile.answer":"Yes, the platform is available on both IOS and Android devices. You can download them on the Apple or Google Play Stores. Learn more \u003ca href='https://support.monday.com/hc/en-us/articles/115005317225-Is-there-an-iPhone-iPad-tablet-and-or-Android-mobile-app-' rel='noopener noreferrer' target='_blank'\u003ehere\u003c/a\u003e.","pricingPage.faq.products.rightPlanForMe.answer":"Work needs are unique, so each kind of project and workflow requires its own set of features. Explore different features in a 14-day free trial for each of the plans above. If you need help in choosing the right plan for you, \u003ca href='https://monday.com/sales/contact-us?from=pricing\u0026source=Website%20-%20Contact%20Sales' target='_blank' rel='noopener noreferrer'\u003eour sales team is here to help\u003c/a\u003e.","pricingPage.faq.products.whatIsWorkMgmt.question":"What is monday work management?","pricingPage.faq.products.whatIsWorkMgmt.answer":"monday work management provides you with the core building blocks you need to manage your work with monday.com. Tackle any process, project, or workflow - and scale and adapt it as your needs evolve.","pricingPage.faq.products.whatUseProductsFor.question":"What can I use monday products for?","pricingPage.faq.products.whatUseProductsFor.answer":"Monday products are end-to-end solutions designed to run the core of your business. monday Work Management helps teams plan, execute, and track work across any workflow with flexible, customizable tools. Sales teams use monday CRM to manage their entire sales cycle, from lead capture to closing deals. Service teams use monday Service to streamline support operations, manage tickets and SLAs, and deliver efficient customer and internal service experiences. Product and R\u0026D teams use monday Dev to plan roadmaps, run sprints, track bugs, and support agile product development from start to finish.","pricingPage.faq.products.howProductsWorkTogether.question":"How do all products work together?","pricingPage.faq.products.howProductsWorkTogether.answer":"You can use all Work OS products in collaboration with each other by easily switching between them inside the platform. Add more products at any time or move your data between products to have all your work under one ecosystem.","pricingPage.faq.products.diffBetweenWorkMgmtAndProducts.question":"What is the difference between monday work management and products?","pricingPage.faq.products.diffBetweenWorkMgmtAndProducts.answer":"Work management equips you with the core building blocks you need to build any workflow from scratch. Work OS products complement work management by providing you with industry-specific workflows and features to get your started, instantly.","pricingPage.faq.products.howPricingWork.answer":"Our pricing structure is based on the feature plan you’d like to use, and the number of seats you purchase. First, choose the work management plan that's right for you and your team. Then, add any tailored monday products (monday CRM, monday dev, monday service, and more) in order to complement your solution. Lastly, choose the number of seats that fits your team and your preferred subscription. Payment is made in one upfront installment (yearly) or month-to-month.","pricingPage.plans.free.title":"Individual","pricingPage.plans.free.title.name_free":"Free","pricingPage.plans.basic.title":"Basic","pricingPage.plans.standard.title":"Standard","pricingPage.plans.pro.title":"Pro","pricingPage.plans.enterprise.title":"Enterprise","pricingPage.plans.ultimate.title":"Ultimate","pricingPage.plans.enterprise.disclaimer":"* Ultimate is a new name for our Enterprise tier","pricingPage.plans.enterprise.cta.talkToSales":"Talk to sales","pricingPage.enterprise.aiBundle.title":"Enterprise AI bundle","pricingPage.enterprise.aiBundle.heading":"One AI","pricingPage.enterprise.aiBundle.subtitle":"All in one","pricingPage.enterprise.aiBundle.description":"Unlock advanced AI capabilities with monday's all in one bundle, customized for your needs","pricingPage.enterprise.aiBundle.contactSales":"Contact sales","pricingPage.enterprise.aiBundle.tooltip.vibe":"Build secure, custom business software in minutes, in the context of work","pricingPage.enterprise.aiBundle.tooltip.sidekick":"An intelligent, context-aware AI assistant that understands, connects, and runs your work.","pricingPage.enterprise.aiBundle.tooltip.ai-credits":"Run AI powered features that streamline your work.","pricingPage.plans.student.title":"Student","pricingPage.plans.npo.title":"Nonprofit","pricingPage.freeForDurationOfStudies":"Free for the duration of your studies","pricingPage.plans.npo.discount":"70% discount","pricingPage.tierDescriptions.student":"For students looking to keep track of their tasks and work.","pricingPage.tierDescriptions.individual.new":"For individuals looking to keep track of their work","pricingPage.tierDescriptions.individual.new.name_free":"For small teams looking to keep track of their work","pricingPage.tierDescriptions.basic.new":"Manage all your teams’ work in one place","pricingPage.tierDescriptions.standard.new":"Collaborate and optimize your team processes","pricingPage.tierDescriptions.pro.new":"Streamline and run your teams’ complex workflows","pricingPage.tierDescriptions.enterprise.new":"For organizations seeking enterprise-grade features","pricingPage.tierDescriptions.crm.free":"Organize your contacts, sales pipelines, and marketing for small businesses– recommended for 3 users.","pricingPage.tierDescriptions.crm.basic":"Organize your contacts, sales pipelines, and marketing for small businesses– recommended for 3 users.","pricingPage.tierDescriptions.crm.standard":"Track your contacts, pipelines, and projects with visualization tools and automations.","pricingPage.tierDescriptions.crm.pro":"A complete CRM platform to manage your sales cycle from A-Z with powerful tools and automations.","pricingPage.tierDescriptions.crm.enterprise":"Enterprise-grade business workflows and CRM capabilities combined with unlimited enterprise support.","pricingPage.tierDescriptions.marketing.basic":"Organize your marketing workflows, requests and activities for small businesses","pricingPage.tierDescriptions.marketing.standard":"Track online campaigns, creative requests, and projects with visualizations and automations","pricingPage.tierDescriptions.marketing.pro":"A complete marketing platform to manage your marketing and creative processes from A-Z with powerful tools, visualizations and automations","pricingPage.tierDescriptions.marketing.enterprise":"Enterprise-grade business workflows and marketing capabilities combined with unlimited enterprise support","pricingPage.tierDescriptions.pmo.basic":"Manage team tasks and simple projects.","pricingPage.tierDescriptions.pmo.standard":"Plan and track projects and tasks with visualization tools and automations.","pricingPage.tierDescriptions.pmo.pro":"Manage projects and processes from A-Z with powerful analytical tools and automations.","pricingPage.tierDescriptions.pmo.enterprise":"Enterprise-grade business workflows and analytics combined with unlimited enterprise support.","pricingPage.tierDescriptions.npo.pro":"For nonprofits that need to manage their operations, projects, volunteers, and donors from A to Z. Your first 10 seats are free.","pricingPage.tierDescriptions.npo.enterprise":"For nonprofit organizations that need enterprise-grade security, control, and support.","pricingPage.tierDescriptions.dev.basic":"Organize your roadmap and development tasks in one place","pricingPage.tierDescriptions.dev.standard":"Visualize and track your roadmap, releases and iterations from planning till execution","pricingPage.tierDescriptions.dev.pro":"Manage product development from A-Z with powerful analytical tools, automations, and integrations","pricingPage.tierDescriptions.dev.enterprise":"Enterprise-grade business workflows and analytics combined with unlimied enterprise support.","pricingPage.features.sections.essentials":"Essentials","pricingPage.features.sections.communication_essentials":"Communication essentials","pricingPage.features.sections.collaboration_and_sharing_essentials":"Collaboration essentials","pricingPage.features.sections.insights_essentials":"Insights essentials","pricingPage.features.sections.other_essentials":"Other essentials","pricingPage.features.sections.remote_work":"Remote work","pricingPage.features.sections.advanced":"Advanced","pricingPage.features.sections.security":"Security \u00